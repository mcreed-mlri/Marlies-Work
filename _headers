/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/sw-register.js
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/court-forms/*
  Cache-Control: no-cache

# Same reason as court-forms above: reviewers must see the current build, not a
# cached one. Added when masslegalhelp/ was created; without it these pages fall
# through to the default and a reviewer can be looking at yesterday's copy while
# saying it reads fine.
/masslegalhelp/*
  Cache-Control: no-cache

/masslegalhelp/tool/*
  Cache-Control: no-cache

/tool/*
  Cache-Control: no-cache

# The screener landing page. `/*.html` above does not cover it: the request path
# for a directory index is `/screener/`, which does not end in .html, so without
# this rule the page a reviewer is sent to first was the one page that could be
# served stale.
/screener/*
  Cache-Control: no-cache
