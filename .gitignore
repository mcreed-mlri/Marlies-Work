# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Claude Code local overrides (keep shared settings.json tracked)
.claude/settings.local.json

# Vercel
.vercel

# Node
node_modules/

# Python bytecode from running the Docassemble package tests locally
__pycache__/
*.py[cod]

# Local files that are not part of the repo, chiefly the MLRI author's copy drafts.
# Deliberately untracked per PRODUCT.md: they are the source of the screener's wording
# and every outbound URL, but they are hers rather than the repo's. Ignored rather than
# merely untracked so they stop appearing in `git status`, and so a `git add -A` cannot
# sweep an author draft into a commit. See _local/README.md before deleting anything
# in there; it is the provenance of the copy, not scratch.
_local/

# Impeccable live mode runtime state (config.json stays tracked)
.impeccable/live/sessions/
.impeccable/live/roots.json
.impeccable/live/inject-journal.json
